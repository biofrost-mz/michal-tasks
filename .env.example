# Frontend (Vite) – zkopíruj do .env.local
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Volitelné
VITE_OWM_API_KEY=                 # OpenWeatherMap pro počasí na dashboardu
VITE_VAPID_PUBLIC_KEY=            # web push notifikace
VITE_SYSTEM_ADMIN_EMAILS=         # čárkou oddělené e-maily s přístupem do admin sekce
VITE_ENABLE_REMOTE_ERROR_LOGGING= # true = posílat chyby do edge funkce client-error-log
VITE_AI_HISTORY_INPUT_PREVIEW=
VITE_APP_VERSION=

# Supabase Edge Functions – nastavují se přes `supabase secrets set`, NE do frontendu:
# SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, CRON_SECRET, APP_URL, EMAIL_LOGO_URL,
# GOOGLE_GENERATIVE_AI_API_KEY, ANTHROPIC_API_KEY, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
